JWT_SECRET=replace-with-a-local-secret
JWT_EXPIRATION=10m
NODE_ENV=development
PORT=3000
MONGO_URI_LOCAL=mongodb://localhost:27017
DB_NAME=sdl_web_App

# SMTP credentials are required for application and contact-form email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=replace-with-a-secret
SMTP_FROM=website@sdl.org.mk
TRUST_PROXY_HOPS=0

# Optional. Default to ./assets and ./uploads in the backend's working directory.
# Set when they live elsewhere, e.g. next to the backend folder on the server.
# ASSETS_DIR=/var/www/assets
# UPLOADS_DIR=/var/www/uploads

# In production, set NODE_ENV=production and provide the cloud URI as MONGO_URI.
