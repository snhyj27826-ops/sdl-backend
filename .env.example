JWT_SECRET=replace-with-a-local-secret
JWT_EXPIRATION=10m
NODE_ENV=development
PORT=3000
MONGO_URI_LOCAL=mongodb://localhost:27017
DB_NAME=sdl_web_App

# SMTP credentials are required for application and contact-form email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=replace-with-a-secret
SMTP_FROM=website@sdl.org.mk
TRUST_PROXY_HOPS=0

# In production, set NODE_ENV=production and provide the cloud URI as MONGO_URI.
